# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Microsoft Entra ID (Azure AD) Configuration
# Required for Microsoft Teams / School account login.
# Get these from: Azure Portal -> Microsoft Entra ID -> App registrations
VITE_MSAL_CLIENT_ID=""
VITE_MSAL_TENANT_ID="common"
VITE_MSAL_REDIRECT_URI="http://localhost:3000"

# Local folder sync (used when Microsoft Teams / MSAL is not configured)
# Set this to the folder name under data/homework/ that the Express API should scan.
VITE_LOCAL_USER_ID="student-001"
LOCAL_API_PORT="3001"

# Qianfan / Baidu API (required for the Analyze Files feature)
# Get your credentials from: https://qianfan.cloud.baidu.com/
API_KEY="..."
APP_ID="..."
